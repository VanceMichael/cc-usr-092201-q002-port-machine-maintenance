  "facts": [
    "智慧港口依赖自动化起重机和智能车辆",
    "多数设备由远程操控室运行",
    "设备故障会直接影响港口作业连续性",
    "报警原文是处置链起点，必须原样保留不得改写",
    "维护主管首先要区分机械故障、校准漂移与未经确认的软件参数",
    "远程诊断只能在授权会话内按最小必要范围取用数据",
    "换件、参数回退、临时旁路与复测必须各自签署留痕",
    "并行检修以锁定范围互不重叠来防止互相覆盖",
    "离线补录必须同时保留实际发生时间与系统记录时间",
    "召回批次命中关联设备时，相应能力随即暂停",
    "调度席需要预计恢复时间与仍可承担动作，而非笼统的维修中",
    "最终放行须回答采用版本、处置人、工具、部件与复核同意理由"
  ],
  "capability_catalog": [
    "自动着箱",
    "远程起落吊",
    "远程人工对位着箱",
    "空吊具移动",
    "自动驳运交接"
  ],
  "diagnostic_scopes": {
    "session_required": true,
    "principle": "最小必要",
    "allowed_scopes": [
      "设备配置:只读",
      "报警事件:只读",
      "部件序列号台账:只读",
      "校准记录:只读",
      "控制软件参数:只读",
      "检修方案:按工单授权"
    ],
    "denied_scopes": [
      "人员资质:联系方式",
      "与本次报警无关设备的历史数据",
      "未经授权的控制软件参数写入"
    ],
    "rules": [
      "会话须绑定报警编号、用途与到期时间",
      "超范围取数必须二次授权并记入会话日志",
      "会话结束后取用凭据立即失效"
    ]
  },
  "signoff_actions": [
    {
      "action": "换件",
      "required_fields": ["处置人", "人员资质编号", "工具", "旧件序列号", "新件序列号", "新件批次", "发生时间", "签署时间"]
    },
    {
      "action": "参数回退",
      "required_fields": ["处置人", "人员资质编号", "参数名", "回退前版本", "回退后版本", "发生时间", "签署时间"]
    },
    {
      "action": "临时旁路",
      "required_fields": ["批准人", "旁路对象", "开始时间", "到期时间", "残余风险", "到期前复核人"]
    },
    {
      "action": "复测",
      "required_fields": ["复测人", "复测项目", "实测值", "判据", "结论", "发生时间"]
    }
  ],
  "parallel_maintenance": {
    "rule": "每张工单声明锁定范围，同一设备上并行工单的锁定范围不得相交",
    "lock_granularity": ["设备", "部件", "软件参数", "校准通道"],
    "conflict_resolution": "范围相交时后提交工单排队等待，不得覆盖先到工单"
  },
  "offline_recording": {
    "rule": "离线补录允许晚于事件登记，但实际发生时间不得被记录时间覆盖",
    "required_fields": ["occurred_at", "recorded_at", "补录人", "补录原因"],
    "ordering": "时间线排序以 occurred_at 为准，审计展示同时显示两个时间"
  },
  "recall_linkage": {
    "rule": "召回公告按批次匹配部件序列号台账，命中设备的相关能力立即转为能力暂停",
    "match_key": "部件批次",
    "effects": ["能力目录中相关动作立即暂停", "已排停机窗口重新评估", "暂停持续到换件并复测通过"],
    "notices": ["召回公告", "能力状态变更", "调度视图刷新"]
  },
  "dispatch_view_fields": [
    "设备编号",
    "当前状态",
    "预计恢复时间",
    "仍可承担的动作",
    "暂停的动作",
    "放行门槛"
